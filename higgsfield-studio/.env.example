# Public origin of this app. The OAuth redirect_uri is derived from it, so it
# must match the URL you actually open in your browser.
# Local:    http://localhost:3000
# Deployed: https://studio.yourdomain.com
APP_URL=http://localhost:3000

# Optional overrides — the defaults are correct for Higgsfield today.
# HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
# HIGGSFIELD_OAUTH_SCOPE=openid email offline_access

# Where tokens, the gallery index, and mirrored images are written.
# DATA_DIR=./.data

# Name shown on the Higgsfield authorization screen.
# OAUTH_CLIENT_NAME=Higgsfield Studio
